   "metadata": {},
   "source": [
    "# DataTour 2026 — Advanced Baseline (LightGBM)\n",
    "## Détection de Fraude Mobile Money avec Validation Temporelle\n",
    "\n",
    "### Objectif\n",
    "- **Défi**: Prédire la probabilité qu'une transaction Mobile Money soit frauduleuse\n",
    "- **Métrique**: Average Precision (PR-AUC) — pas d'accuracy\n",
    "- **Classes**: Fortement déséquilibrées (~0.1% de fraude)\n",
    "\n",
    "### Stratégies Intégrées\n",
    "1. ✓ **Validation Temporelle** (GroupKFold basé sur `period`)\n",
    "2. ✓ **Feature Engineering** — Cohérence comptable & denoise\n",
    "3. ✓ **Agrégations Comportementales** — Profil de compte (sans overfitting)\n",
    "4. ✓ **Séquences & Vélocité** — Décalages temporels\n",
    "5. ✓ **Encodage Robuste** — Target Encoding lissé pour `operation`\n",
    "6. ✓ **LightGBM Optimisé** — Configué pour PR-AUC et imbalance\n",
    "7. ✓ **Inférence Propre** — Soumission valide (id, target)\n",
    "\n",
    "---\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Imports\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "from typing import Tuple, Dict, Optional\n",
    "\n",
    "import lightgbm as lgb\n",
    "from sklearn.model_selection import GroupKFold\n",
    "from sklearn.metrics import average_precision_score, roc_auc_score, roc_curve, precision_recall_curve\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# Configuration de visualisation\n",
    "plt.style.use(\"seaborn-v0_8-darkgrid\")\n",
    "sns.set_palette(\"husl\")\n",
    "np.random.seed(42)\n",
    "\n",
    "print(\"✓ Imports réussis\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1️⃣ Chargement & Exploration des Données\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuration\n",
    "DATA_DIR = Path(\".\")\n",
    "ID_COL = \"id\"\n",
    "TARGET_COL = \"fraud_flag\"\n",
    "PERIOD_COL = \"period\"\n",
    "OPERATION_COL = \"operation\"\n",
    "ORIGIN_ACCOUNT_COL = \"origin_account\"\n",
    "DESTINATION_ACCOUNT_COL = \"destination_account\"\n",
    "\n",
    "# Chargement\n",
    "train_df = pd.read_csv(DATA_DIR / \"train.csv\")\n",
    "test_df = pd.read_csv(DATA_DIR / \"test.csv\")\n",
    "sample_submission = pd.read_csv(DATA_DIR / \"sample_submission.csv\")\n",
    "\n",
    "print(\"📊 DATASET OVERVIEW\")\n",
    "print(f\"Train: {train_df.shape[0]:,} transactions, {train_df.shape[1]} colonnes\")\n",
    "print(f\"Test:  {test_df.shape[0]:,} transactions, {test_df.shape[1]} colonnes\")\n",
    "print()\n",
    "\n",
    "print(\"❌ IMBALANCE\")\n",
    "fraud_rate = train_df[TARGET_COL].mean()\n",
    "print(f\"Taux de fraude: {fraud_rate:.4%} ({train_df[TARGET_COL].sum():,} fraudes / {len(train_df):,} total)\")\n",
    "print()\n",
    "\n",
    "print(\"⏱️ DISTRIBUTION TEMPORELLE\")\n",
    "print(f\"Période min-max: {train_df[PERIOD_COL].min()}-{train_df[PERIOD_COL].max()} ({train_df[PERIOD_COL].nunique()} périodes)\")\n",
    "print(f\"Test période: {test_df[PERIOD_COL].min()}-{test_df[PERIOD_COL].max()}\")\n",
    "print()\n",
    "\n",
    "print(\"📋 APERÇU\")\n",
    "display(train_df.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2️⃣ Feature Engineering Avancé\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_advanced_features(df: pd.DataFrame, fit_mode: bool = False) -> Tuple[pd.DataFrame, Dict]:\n",
    "    \"\"\"\n",
    "    Feature Engineering inspiré par IEEE-CIS et Amex competitions.\n",
    "    \n",
    "    Intègre:\n",
    "    - Cohérence comptable (conservation de l'argent)\n",
    "    - Agrégations comportementales par compte\n",
    "    - Séquences temporelles et vélocité\n",
    "    - Target Encoding robuste des catégories\n",
    "    \"\"\"\n",
    "    df_fe = df.copy()\n",
    "    agg_stats = {}\n",
    "    \n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    # 2.1: COHÉRENCE COMPTABLE & DENOISE\n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    \n",
    "    df_fe[\"origin_balance_delta\"] = (\n",
    "        df_fe[\"origin_balance_before\"] - df_fe[\"origin_balance_after\"]\n",
    "    )\n",
    "    df_fe[\"destination_balance_delta\"] = (\n",
    "        df_fe[\"destination_balance_after\"] - df_fe[\"destination_balance_before\"]\n",
    "    )\n",
    "    \n",
    "    df_fe[\"is_origin_coherent\"] = (\n",
    "        np.abs(df_fe[\"origin_balance_delta\"] - df_fe[\"amount\"]) < 1e-6\n",
    "    ).astype(int)\n",
    "    \n",
    "    df_fe[\"is_destination_coherent\"] = (\n",
    "        np.abs(df_fe[\"destination_balance_delta\"] - df_fe[\"amount\"]) < 1e-6\n",
    "    ).astype(int)\n",
    "    \n",
    "    eps = 1e-8\n",
    "    df_fe[\"amount_ratio_to_origin_balance\"] = (\n",
    "        df_fe[\"amount\"] / (np.abs(df_fe[\"origin_balance_before\"]) + eps)\n",
    "    )\n",
    "    \n",
    "    df_fe[\"amount_ratio_to_destination_balance\"] = (\n",
    "        df_fe[\"amount\"] / (np.abs(df_fe[\"destination_balance_before\"]) + eps)\n",
    "    )\n",
    "    \n",
    "    df_fe[\"amount_log1p\"] = np.log1p(np.abs(df_fe[\"amount\"]))\n",
    "    \n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    # 2.2: AGRÉGATIONS COMPORTEMENTALES (Profil Compte)\n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    \n",
    "    if fit_mode:\n",
    "        origin_agg = df_fe.groupby(ORIGIN_ACCOUNT_COL).agg({\n",
    "            \"amount\": [\"mean\", \"max\", \"std\", \"min\", \"count\"]\n",
    "        }).reset_index()\n",
    "        \n",
    "        origin_agg.columns = [\n",
    "            ORIGIN_ACCOUNT_COL,\n",
    "            \"origin_amount_mean\", \"origin_amount_max\", \"origin_amount_std\",\n",
    "            \"origin_amount_min\", \"origin_transaction_count\"\n",
    "        ]\n",
    "        origin_agg[\"origin_amount_std\"].fillna(0, inplace=True)\n",
    "        \n",
    "        dest_agg = df_fe.groupby(DESTINATION_ACCOUNT_COL).agg({\n",
    "            \"amount\": [\"mean\", \"max\", \"std\", \"min\", \"count\"]\n",
    "        }).reset_index()\n",
    "        \n",
    "        dest_agg.columns = [\n",
    "            DESTINATION_ACCOUNT_COL,\n",
    "            \"destination_amount_mean\", \"destination_amount_max\", \"destination_amount_std\",\n",
    "            \"destination_amount_min\", \"destination_transaction_count\"\n",
    "        ]\n",
    "        dest_agg[\"destination_amount_std\"].fillna(0, inplace=True)\n",
    "        \n",
    "        period_freq = df_fe.groupby([ORIGIN_ACCOUNT_COL, PERIOD_COL]).size().reset_index(name=\"origin_period_txn_count\")\n",
    "        period_freq = period_freq.groupby(ORIGIN_ACCOUNT_COL)[\"origin_period_txn_count\"].agg([\"mean\", \"max\"]).reset_index()\n",
    "        period_freq.columns = [ORIGIN_ACCOUNT_COL, \"origin_period_txn_count_mean\", \"origin_period_txn_count_max\"]\n",
    "        \n",
    "        agg_stats[\"origin_agg\"] = origin_agg\n",
    "        agg_stats[\"dest_agg\"] = dest_agg\n",
    "        agg_stats[\"period_freq\"] = period_freq\n",
    "    else:\n",
    "        origin_agg = agg_stats[\"origin_agg\"]\n",
    "        dest_agg = agg_stats[\"dest_agg\"]\n",
    "        period_freq = agg_stats[\"period_freq\"]\n",
    "    \n",
    "    df_fe = df_fe.merge(origin_agg, on=ORIGIN_ACCOUNT_COL, how=\"left\")\n",
    "    df_fe = df_fe.merge(dest_agg, on=DESTINATION_ACCOUNT_COL, how=\"left\")\n",
    "    df_fe = df_fe.merge(period_freq, on=ORIGIN_ACCOUNT_COL, how=\"left\")\n",
    "    \n",
    "    for col in df_fe.columns:\n",
    "        if col.startswith((\"origin_\", \"destination_\")) and col not in [ORIGIN_ACCOUNT_COL, DESTINATION_ACCOUNT_COL]:\n",
    "            if df_fe[col].dtype != 'object':\n",
    "                df_fe[col].fillna(df_fe[col].median(), inplace=True)\n",
    "    \n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    # 2.3: SÉQUENCES ET VÉLOCITÉ\n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    \n",
    "    df_fe = df_fe.sort_values([ORIGIN_ACCOUNT_COL, PERIOD_COL]).reset_index(drop=True)\n",
    "    \n",
    "    df_fe[\"amount_prev\"] = df_fe.groupby(ORIGIN_ACCOUNT_COL)[\"amount\"].shift(1)\n",
    "    df_fe[\"amount_prev\"].fillna(df_fe[\"amount\"].median(), inplace=True)\n",
    "    \n",
    "    df_fe[\"amount_ratio_prev\"] = (\n",
    "        df_fe[\"amount\"] / (np.abs(df_fe[\"amount_prev\"]) + eps)\n",
    "    )\n",
    "    \n",
    "    df_fe[\"period_diff\"] = df_fe.groupby(ORIGIN_ACCOUNT_COL)[PERIOD_COL].diff()\n",
    "    df_fe[\"period_diff\"].fillna(1, inplace=True)\n",
    "    \n",
    "    df_fe[\"period_velocity\"] = 1.0 / (df_fe[\"period_diff\"] + eps)\n",
    "    \n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    # 2.4: SUPPRESSION DES UID BRUTS\n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    \n",
    "    df_fe = df_fe.drop(columns=[ORIGIN_ACCOUNT_COL, DESTINATION_ACCOUNT_COL])\n",
    "    \n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    # 2.5: TARGET ENCODING DE 'operation'\n",
    "    # ───────────────────────────────────────────────────────────\n",
    "    \n",
    "    if fit_mode and TARGET_COL in df_fe.columns:\n",
    "        operation_stats = df_fe.groupby(OPERATION_COL)[TARGET_COL].agg([\"mean\", \"count\"]).reset_index()\n",
    "        operation_stats.columns = [OPERATION_COL, \"operation_target_mean\", \"operation_count\"]\n",
    "        \n",
    "        global_mean = df_fe[TARGET_COL].mean()\n",
    "        m = 100  # Smoothing parameter\n",
    "        \n",
    "        operation_stats[\"operation_target_encoded\"] = (\n",
    "            (operation_stats[\"operation_count\"] * operation_stats[\"operation_target_mean\"] + m * global_mean) /\n",
    "            (operation_stats[\"operation_count\"] + m)\n",
    "        )\n",
    "        \n",
    "        agg_stats[\"operation_encoding\"] = operation_stats[[OPERATION_COL, \"operation_target_encoded\"]]\n",
    "    else:\n",
    "        operation_stats = agg_stats.get(\"operation_encoding\", None)\n",
    "    \n",
    "    if operation_stats is not None:\n",
    "        df_fe = df_fe.merge(\n",
    "            operation_stats.rename(columns={\"operation_target_encoded\": \"operation_encoded\"}),\n",
    "            on=OPERATION_COL,\n",
    "            how=\"left\"\n",
    "        )\n",
    "        df_fe[\"operation_encoded\"].fillna(df_fe[\"operation_encoded\"].median(), inplace=True)\n",
    "    \n",
    "    df_fe[OPERATION_COL] = df_fe[OPERATION_COL].astype(\"category\")\n",
    "    \n",
    "    return df_fe, agg_stats\n",
    "\n",
    "# Appliquer\n",
    "print(\"🔧 Feature Engineering (TRAIN)...\")\n",
    "train_fe, agg_stats = create_advanced_features(train_df, fit_mode=True)\n",
    "print(f\"   → {train_fe.shape[1]} features créées\\n\")\n",
    "\n",
    "print(\"🔧 Feature Engineering (TEST)...\")\n",
    "test_fe, _ = create_advanced_features(test_df, fit_mode=False)\n",
    "print(f\"   → Train FE: {train_fe.shape}\")\n",
    "print(f\"   → Test FE:  {test_fe.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3️⃣ Validation Temporelle (GroupKFold)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Préparation\n",
    "X_train = train_fe.drop(columns=[ID_COL, TARGET_COL, PERIOD_COL])\n",
    "y_train = train_fe[TARGET_COL].values\n",
    "groups = train_fe[PERIOD_COL].values\n",
    "\n",
    "print(\"⏱️ VALIDATION TEMPORELLE\")\n",
    "print(f\"X_train: {X_train.shape}\")\n",
    "print(f\"y_train: {y_train.shape}\")\n",
    "print(f\"Groupes (periods): {np.unique(groups).shape[0]} uniques\\n\")\n",
    "\n",
    "# GroupKFold (3 folds)\n",
    "kfold = GroupKFold(n_splits=3)\n",
    "fold_list = list(kfold.split(X_train, y_train, groups))\n",
    "\n",
    "print(f\"Splits: {len(fold_list)} folds\\n\")\n",
    "for fold_idx, (train_idx, val_idx) in enumerate(fold_list):\n",
    "    train_periods = sorted(np.unique(groups[train_idx]))\n",
    "    val_periods = sorted(np.unique(groups[val_idx]))\n",
    "    print(f\"Fold {fold_idx}:\")\n",
    "    print(f\"  Train periods: {train_periods[:3]} ... {train_periods[-3:]} (n={len(train_periods)})\")\n",
    "    print(f\"  Val periods:   {val_periods[:3]} ... {val_periods[-3:]} (n={len(val_periods)})\")\n",
    "    print(f\"  Train samples: {len(train_idx):,}, Val samples: {len(val_idx):,}\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4️⃣ Configuration LightGBM\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calcul du ratio de classes\n",
    "n_neg = (y_train == 0).sum()\n",
    "n_pos = (y_train == 1).sum()\n",
    "scale_pos_weight = n_neg / n_pos\n",
    "\n",
    "print(\"⚖️ IMBALANCE\")\n",
    "print(f\"Classe 0 (normal): {n_neg:,} ({100*n_neg/len(y_train):.2f}%)\")\n",
    "print(f\"Classe 1 (fraude): {n_pos:,} ({100*n_pos/len(y_train):.2f}%)\")\n",
    "print(f\"Ratio (0/1): {scale_pos_weight:.2f}\\n\")\n",
    "\n",
    "# Paramètres LightGBM\n",
    "lgb_params = {\n",
    "    \"objective\": \"binary\",\n",
    "    \"metric\": \"average_precision\",\n",
    "    \"boosting_type\": \"gbdt\",\n",
    "    \"is_unbalance\": False,\n",
    "    \"scale_pos_weight\": scale_pos_weight,\n",
    "    \n",
    "    \"num_leaves\": 31,\n",
    "    \"max_depth\": 8,\n",
    "    \"learning_rate\": 0.05,\n",
    "    \"feature_fraction\": 0.8,\n",
    "    \"bagging_fraction\": 0.8,\n",
    "    \"bagging_freq\": 5,\n",
    "    \"min_child_samples\": 20,\n",
    "    \"min_child_weight\": 0.001,\n",
    "    \"lambda_l1\": 0.1,\n",
    "    \"lambda_l2\": 0.1,\n",
    "    \n",
    "    \"categorical_feature\": [OPERATION_COL],\n",
    "    \"num_threads\": -1,\n",
    "    \"verbose\": -1,\n",
    "}\n",
    "\n",
    "print(\"⚙️ LightGBM Parameters:\")\n",
    "for k, v in lgb_params.items():\n",
    "    if k != \"categorical_feature\":\n",
    "        print(f\"  {k}: {v}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5️⃣ Entraînement avec Validation Temporelle\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "all_val_scores = []\n",
    "all_train_scores = []\n",
    "fold_boosters = []\n",
    "\n",
    "for fold_idx, (train_idx, val_idx) in enumerate(fold_list):\n",
    "    print(f\"\\n🔄 FOLD {fold_idx + 1}/3\")\n",
    "    \n",
    "    X_tr, X_val = X_train.iloc[train_idx], X_train.iloc[val_idx]\n",
    "    y_tr, y_val = y_train[train_idx], y_train[val_idx]\n",
    "    \n",
    "    # Datasets LightGBM\n",
    "    train_data = lgb.Dataset(\n",
    "        X_tr, label=y_tr,\n",
    "        categorical_feature=[OPERATION_COL],\n",
    "        free_raw_data=False\n",
    "    )\n",
    "    \n",
    "    val_data = lgb.Dataset(\n",
    "        X_val, label=y_val,\n",
    "        reference=train_data,\n",
    "        categorical_feature=[OPERATION_COL],\n",
    "        free_raw_data=False\n",
    "    )\n",
    "    \n",
    "    # Entraînement\n",
    "    booster = lgb.train(\n",
    "        lgb_params,\n",
    "        train_data,\n",
    "        num_boost_round=500,\n",
    "        valid_sets=[train_data, val_data],\n",
    "        valid_names=[\"train\", \"valid\"],\n",
    "        callbacks=[\n",
    "            lgb.early_stopping(stopping_rounds=50, verbose=False),\n",
    "            lgb.log_evaluation(period=50)\n",
    "        ]\n",
    "    )\n",
    "    \n",
    "    fold_boosters.append(booster)\n",
    "    \n",
    "    # Métriques\n",
    "    y_train_pred = booster.predict(X_tr)\n",
    "    y_val_pred = booster.predict(X_val)\n",
    "    \n",
    "    train_ap = average_precision_score(y_tr, y_train_pred)\n",
    "    val_ap = average_precision_score(y_val, y_val_pred)\n",
    "    train_auc = roc_auc_score(y_tr, y_train_pred)\n",
    "    val_auc = roc_auc_score(y_val, y_val_pred)\n",
    "    \n",
    "    all_train_scores.append((train_ap, train_auc))\n",
    "    all_val_scores.append((val_ap, val_auc))\n",
    "    \n",
    "    print(f\"  Rounds: {booster.num_trees()}\")\n",
    "    print(f\"  Train → AP: {train_ap:.4f}, ROC-AUC: {train_auc:.4f}\")\n",
    "    print(f\"  Val   → AP: {val_ap:.4f}, ROC-AUC: {val_auc:.4f}\")\n",
    "\n",
    "# Résumé\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"📊 RÉSUMÉ VALIDATION (3-Fold)\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "train_aps = [s[0] for s in all_train_scores]\n",
    "val_aps = [s[0] for s in all_val_scores]\n",
    "train_aucs = [s[1] for s in all_train_scores]\n",
    "val_aucs = [s[1] for s in all_val_scores]\n",
    "\n",
    "print(f\"\\nAverage Precision (PR-AUC):\")\n",
    "print(f\"  Train: {np.mean(train_aps):.4f} ± {np.std(train_aps):.4f}\")\n",
    "print(f\"  Val:   {np.mean(val_aps):.4f} ± {np.std(val_aps):.4f}\")\n",
    "\n",
    "print(f\"\\nROC-AUC:\")\n",
    "print(f\"  Train: {np.mean(train_aucs):.4f} ± {np.std(train_aucs):.4f}\")\n",
    "print(f\"  Val:   {np.mean(val_aucs):.4f} ± {np.std(val_aucs):.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6️⃣ Entraînement Final sur Tout le Dataset\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\\n🎯 ENTRAÎNEMENT FINAL (tout le train)\\n\")\n",
    "\n",
    "final_train_data = lgb.Dataset(\n",
    "    X_train,\n",
    "    label=y_train,\n",
    "    categorical_feature=[OPERATION_COL],\n",
    "    free_raw_data=False\n",
    ")\n",
    "\n",
    "final_booster = lgb.train(\n",
    "    lgb_params,\n",
    "    final_train_data,\n",
    "    num_boost_round=300,\n",
    "    callbacks=[lgb.log_evaluation(period=50)]\n",
    ")\n",
    "\n",
    "print(f\"\\n✓ Modèle final: {final_booster.num_trees()} rounds\\n\")\n",
    "\n",
    "# Feature Importance\n",
    "feature_importance = final_booster.feature_importance(importance_type=\"gain\")\n",
    "feature_names = X_train.columns.tolist()\n",
    "importance_df = pd.DataFrame({\n",
    "    \"feature\": feature_names,\n",
    "    \"importance\": feature_importance\n",
    "}).sort_values(\"importance\", ascending=False)\n",
    "\n",
    "print(\"📊 Top 15 Features:\")\n",
    "print(importance_df.head(15).to_string(index=False))\n",
    "\n",
    "# Visualisation\n",
